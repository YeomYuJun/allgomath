# .env 템플릿. `cp .env.example .env` 후 값을 채운다.
# docker compose 는 compose 파일과 같은 디렉터리의 .env 를 자동으로 읽는다. .env 는 커밋되지 않는다.
#
# GF_SECURITY_ADMIN_PASSWORD 는 Grafana 최초 기동 시에만 적용된다.
# 기존 인스턴스의 비밀번호 변경은 UI 또는 아래 명령으로 한다.
#   docker exec -it allgomath-grafana grafana-cli admin reset-admin-password '새비밀번호'

GF_SECURITY_ADMIN_PASSWORD=
